# Server
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security — change in production
SECRET_KEY=replace-with-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local dev: SQLite is fine.
DATABASE_URL=sqlite:///./trustmind.db
# Production / Render: REQUIRED PostgreSQL (SQLite on Render is ephemeral and
# wipes users + check-in history on every redeploy). Paste the Render Postgres
# Internal URL (same region) with no quotes:
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE
# postgres:// and postgresql:// are auto-normalised to postgresql+psycopg2://.
# External URL (local/CI) usually needs ?sslmode=require; Internal usually does not.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/trustmind

# Analyse engine: auto | llm | keywords
# auto = use LLM pipelines when OPENAI_API_KEY or GEMINI_API_KEY is set
ANALYSE_BACKEND=auto
# LLM routing: auto (Groq → Gemini → OpenAI) | free | groq | gemini | openai
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TEMPERATURE=0.2

# Recommended free/fast: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Free Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Mode A (false) = standalone LLM | Mode B (true) = hybrid RAG grounding
USE_RAG=false
RAG_TOP_K=5

# Trust / ethics
CONFIDENCE_THRESHOLD=0.75
ENABLE_ABSTENTION=true
ENABLE_SOURCE_DISPLAY=true
ENABLE_SUPPORT_RESOURCES=true

# Evidence-based confidence calibration
ENABLE_CONFIDENCE_CALIBRATION=true
CONSISTENCY_RUNS=3
CONSISTENCY_TEMPERATURE=0.3

# Grounding thresholds (0–100 trust-signal scale)
GROUNDING_RETRIEVAL_QUALITY_MIN=55
GROUNDING_EVIDENCE_STRENGTH_MIN=50
