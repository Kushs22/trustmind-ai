# Server
API_HOST=127.0.0.1
API_PORT=8000

# CORS — comma-separated allowlist (never use * in production)
# Defaults also include https://trustmind-ai.vercel.app when unset in code;
# set explicitly on Render. Add a custom domain via CORS_ORIGINS and/or FRONTEND_URL.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://trustmind-ai.vercel.app
# FRONTEND_URL=https://www.example.com

# Security — REQUIRED in production (Render sets RENDER=true and will refuse weak keys).
# Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do NOT commit real secrets. Rotate if leaked.
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local dev: SQLite is fine.
DATABASE_URL=sqlite:///./trustmind.db
# Production / Render: REQUIRED PostgreSQL (SQLite on Render is ephemeral and
# wipes users + check-in history on every redeploy). Paste the Render Postgres
# Internal URL (same region) with no quotes — do not expose the DB publicly:
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE
# postgres:// and postgresql:// are auto-normalised to postgresql+psycopg2://.
# External URL (local/CI) usually needs ?sslmode=require; Internal usually does not.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/trustmind

# Analyse engine: auto | llm | keywords
# auto = use LLM pipelines when OPENAI_API_KEY or GEMINI_API_KEY is set
ANALYSE_BACKEND=auto
# LLM routing: auto (Groq → Gemini → OpenAI) | free | groq | gemini | openai
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TEMPERATURE=0.2

# Recommended free/fast: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Free Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Mode A (false) = standalone LLM | Mode B (true) = hybrid RAG grounding
USE_RAG=false
RAG_TOP_K=5

# Trust / ethics
CONFIDENCE_THRESHOLD=0.75
ENABLE_ABSTENTION=true
ENABLE_SOURCE_DISPLAY=true
ENABLE_SUPPORT_RESOURCES=true

# Evidence-based confidence calibration
ENABLE_CONFIDENCE_CALIBRATION=true
CONSISTENCY_RUNS=3
CONSISTENCY_TEMPERATURE=0.3

# Grounding thresholds (0–100 trust-signal scale)
GROUNDING_RETRIEVAL_QUALITY_MIN=55
GROUNDING_EVIDENCE_STRENGTH_MIN=50

# Rate limits (requests per RATE_LIMIT_WINDOW_SECONDS per client IP)
RATE_LIMIT_WINDOW_SECONDS=60
ANALYSE_RATE_LIMIT_COUNT=15
AUTH_LOGIN_RATE_LIMIT_COUNT=5
AUTH_REGISTER_RATE_LIMIT_COUNT=5
AUTH_ANONYMOUS_RATE_LIMIT_COUNT=10
CHAT_RATE_LIMIT_COUNT=20
UPLOAD_RATE_LIMIT_COUNT=30
TRANSCRIBE_RATE_LIMIT_COUNT=20
