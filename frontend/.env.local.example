# Public frontend env only — never put OpenAI / Groq / Gemini / SECRET_KEY here.
# These values are embedded in the browser bundle.

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production (Vercel): set NEXT_PUBLIC_API_URL=https://trustmind-ai.onrender.com
# (or your Render custom API domain). LLM keys stay on the backend only.
